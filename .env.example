# ============ Laravel ============
# Generate with: openssl rand -base64 32
APP_KEY=base64:Q/VcMLnqJBHZLW6qlv5M5BsoeMbedq+pc4Rx5h10iDI=
APP_URL=http://localhost:8080
MAX_BATCH_SIZE=100

# ============ PostgreSQL ============
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather_password
POSTGRES_DB=weather_db

# ============ RabbitMQ ============
RABBITMQ_DEFAULT_USER=weather
RABBITMQ_DEFAULT_PASS=weather_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_QUEUE=telemetry.ingest

# Seed API key for the demo device (used by db/init/002_seed.sh)
DEMO_DEVICE_API_KEY=dev_demo_weather_station_2024

# ============ Frontend ============
# Base URL used by the Next.js server to reach the backend inside Docker.
BACKEND_INTERNAL_URL=http://backend:8080
# Base URL exposed to the browser (backend port is published on host 8080).
NEXT_PUBLIC_API_URL=http://localhost:8080